# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
# Where the Next.js frontend lives — /auth/callback redirects here once the
# session cookie is set, since the backend itself has no UI routes.
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
# Async URL used by the running app
DATABASE_URL=postgresql+asyncpg://puma_dms:changeme@localhost:5432/puma_dms
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://puma_dms:changeme@localhost:5432/puma_dms

# ── Microsoft Entra ID (Phase 1 auth) ───────────────────────
# Values come from your Entra ID App Registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
# Scopes requested at login (Graph scopes added in Phase 2)
ENTRA_SCOPES=User.Read

# ── SharePoint / Graph (Phase 2) ─────────────────────────────
# GRAPH_SITE_ID and GRAPH_DRIVE_ID identify the single SharePoint site/
# document library the DMS uses (spec Section 4: one site, department
# folders at the root). Get them via Graph Explorer or:
#   GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site-path}
#   GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
# The same app registration used for ENTRA_CLIENT_ID/SECRET above needs the
# Sites.Selected APPLICATION permission (admin-consented), then a site
# admin must grant that specific app "write" access to this one site via:
#   POST /sites/{site-id}/permissions  (see Microsoft Graph docs for Sites.Selected)
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=

# ── Session ──────────────────────────────────────────────────
SESSION_COOKIE_NAME=puma_dms_session
SESSION_EXPIRE_MINUTES=480

# ── OCR (Phase 4) ────────────────────────────────────────────
# Leave blank on Linux (apt-installed tesseract is already on PATH). On
# Windows, set this to the full path to tesseract.exe — installers like
# winget's UB-Mannheim build don't reliably land on PATH for already-
# running processes, e.g.:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
